# Copy to .env.local for local dev.
# On Vercel: Project → Settings → Environment Variables → add for Production (+ Preview).

# Supabase project URL (Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://ugtisndgwlhimugiervc.supabase.co

# Publishable / anon key (Dashboard → Project Settings → API → anon public or publishable)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alias accepted by the client (optional if PUBLISHABLE_KEY is set)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin panel password (required for admin login). Use a long unique secret.
NEXT_PUBLIC_ADMIN_PASSWORD=
